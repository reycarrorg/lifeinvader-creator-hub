{
  "manifest_version": 3,
  "name": "Snapmatic · Group DM & Analytics Bridge",
  "version": "0.3.0",
  "description": "Auto-downloads shared posts from your pinned TikTok Group DM (cj_4_prez's group) and refreshes profile counts for Snapmatic.",
  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "http://127.0.0.1:3847/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/business-suite/messages*",
        "https://www.tiktok.com/messages*"
      ],
      "js": ["group_dm_collector.js", "content_dm.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Snapmatic Bridge",
    "default_popup": "popup.html"
  }
}
